PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Use an Atlas application URI or a local MongoDB instance.
# Percent-encode special characters in the database password.
MONGODB_URI=mongodb://127.0.0.1:27017/blog-platform
# Generate a random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters-long
