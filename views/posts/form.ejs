<%- include('../partials/head') %>
<main id="main" class="container editor-main">
  <div class="page-topline"><a class="text-link" href="<%= editing ? '/posts/' + post._id : '/posts' %>"><%= editing ? 'Back to your story' : 'Back to the journal' %></a><span class="edition-label">YOUR WORDS. YOUR PERSPECTIVE.</span></div>
  <div class="editor-heading"><p class="eyebrow"><span class="little-line"></span> THE WRITING ROOM</p><h1><%= editing ? 'Make it your own.' : 'An idea starts here.' %></h1><p><%= editing ? 'A fresh thought, a better sentence. Every edit counts.' : 'Big discoveries or small observations. There’s room for both.' %></p></div>
  <% if (Object.keys(errors).length) { %><div class="validation-summary" role="alert" tabindex="-1" data-error-summary><strong>A few details need your attention.</strong><ul><% for (const [field, message] of Object.entries(errors)) { %><li><a href="#<%= field %>"><%= field.charAt(0).toUpperCase() + field.slice(1) %>: <%= message %></a></li><% } %></ul></div><% } %>
  <form class="editor-form" action="<%= editing ? '/posts/' + post._id : '/posts' %>" method="post" data-editor-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (editing) { %><input type="hidden" name="_method" value="PUT"><% } %>
    <div class="editor-columns">
      <div class="editor-content">
        <div class="field"><label for="title">Story title</label><input class="title-input" id="title" name="title" placeholder="Give your idea a title" required minlength="3" maxlength="140" value="<%= post.title %>" <%- errors.title ? 'aria-invalid="true" aria-describedby="title-error"' : '' %>><% if (errors.title) { %><span class="field-error" id="title-error"><%= errors.title %></span><% } %></div>
        <div class="field"><label for="excerpt">A short introduction <span class="label-note">Appears in the journal</span></label><textarea id="excerpt" name="excerpt" rows="3" placeholder="A sentence or two to invite the reader in." required minlength="10" maxlength="280" <%- errors.excerpt ? 'aria-invalid="true" aria-describedby="excerpt-error"' : '' %>><%= post.excerpt %></textarea><% if (errors.excerpt) { %><span class="field-error" id="excerpt-error"><%= errors.excerpt %></span><% } %></div>
        <div class="field"><label for="content">Your story</label><div class="writing-area"><div class="format-toolbar" role="group" aria-label="Text formatting"><button type="button" data-format="heading" title="Add a heading">H2</button><button type="button" data-format="bold" title="Bold text"><strong>B</strong></button><button type="button" data-format="italic" title="Italic text"><em>I</em></button><button type="button" data-format="list" title="Bullet list">List</button><button type="button" data-format="quote" title="Block quote">Quote</button><span>Markdown supported</span></div><textarea id="content" name="content" rows="17" placeholder="Start with what’s on your mind…" required minlength="20" maxlength="60000" aria-describedby="content-help<%= errors.content ? ' content-error' : '' %>" <%- errors.content ? 'aria-invalid="true"' : '' %>><%= post.content %></textarea><div class="writing-footer"><span id="content-help">Simple words. A fresh perspective.</span><output id="word-count" for="content">0 words</output></div></div><% if (errors.content) { %><span class="field-error" id="content-error"><%= errors.content %></span><% } %></div>
      </div>
      <aside class="editor-sidebar" aria-label="Story details">
        <div class="sidebar-card"><h2>The details</h2><div class="field"><label for="author">Author name</label><input id="author" name="author" placeholder="Your name" autocomplete="name" required minlength="2" maxlength="60" value="<%= post.author %>" <%- errors.author ? 'aria-invalid="true" aria-describedby="author-error"' : '' %>><% if (errors.author) { %><span class="field-error" id="author-error"><%= errors.author %></span><% } %></div><div class="field"><label for="category">Category</label><select id="category" name="category" required <%- errors.category ? 'aria-invalid="true" aria-describedby="category-error"' : '' %>><% for (const item of categories) { %><option value="<%= item %>" <%= post.category === item ? 'selected' : '' %>><%= item %></option><% } %></select><% if (errors.category) { %><span class="field-error" id="category-error"><%= errors.category %></span><% } %></div>
          <fieldset class="cover-field" id="cover"><legend>Cover color</legend><div class="cover-options"><% for (const color of covers) { %><label class="cover-option"><input type="radio" name="cover" value="<%= color %>" required <%= post.cover === color ? 'checked' : '' %>><span class="color-swatch swatch-<%= color %>"><span class="swatch-check" aria-hidden="true">✓</span></span><span class="color-name"><%= color %></span></label><% } %></div><% if (errors.cover) { %><span class="field-error" id="cover-error"><%= errors.cover %></span><% } %></fieldset>
          <div class="publishing-note"><span aria-hidden="true">✳</span><p><%= editing ? 'Your changes will be visible as soon as you save.' : 'Your story will be visible in the journal as soon as you publish.' %></p></div><button type="submit" class="button button-blue button-full"><%= editing ? 'Save changes' : 'Publish story' %></button><a class="cancel-link" href="<%= editing ? '/posts/' + post._id : '/posts' %>">Cancel</a>
        </div>
        <details class="writing-help"><summary>A little Markdown help</summary><p><code>## A heading</code></p><p><code>**Bold**</code> or <code>*italic*</code></p><p><code>- A list item</code></p><p><code>[Link text](https://example.com)</code></p><p>Leave a blank line between paragraphs.</p></details>
      </aside>
    </div>
  </form>
</main>
<%- include('../partials/footer') %>
