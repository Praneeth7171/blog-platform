<%- include('../partials/head') %>
<main id="main" class="container article-main">
  <div class="page-topline"><a class="text-link" href="/posts">Back to the journal</a><div class="article-actions"><a class="button button-outline button-small" href="/posts/<%= post._id %>/edit">Edit story</a><a class="subtle-link" href="/posts/<%= post._id %>/delete">Delete</a></div></div>
  <article>
    <header class="article-heading">
      <div class="story-meta"><a class="category-text" href="/posts?category=<%= encodeURIComponent(post.category) %>"><%= post.category %></a><span class="meta-divider">/</span><span><%= readTime(post.content) %> min read</span></div>
      <h1><%= post.title %></h1><p class="article-deck"><%= post.excerpt %></p>
      <div class="article-byline"><span class="avatar avatar-large" aria-hidden="true"><%= initials(post.author) %></span><div><span class="author-name"><%= post.author %></span><time datetime="<%= new Date(post.createdAt).toISOString() %>">Published <%= formatDate(post.createdAt) %></time></div></div>
    </header>
    <div class="article-cover"><%- include('../partials/cover', { post, large: true }) %></div>
    <div class="article-body"><%- contentHtml %></div>
    <footer class="article-end"><span class="end-mark" aria-hidden="true">✳</span><p>Thanks for reading.</p><a class="text-link" href="/posts">Explore more stories</a></footer>
  </article>
</main>
<%- include('../partials/footer') %>
